{
  "name": "tokensleft",
  "version": "0.9.6",
  "description": "Headless quota CLI for AI agents — Claude Code, Codex, Gemini CLI, Kimi Code, Copilot, Grok, Antigravity, OpenCode, and z.ai.",
  "license": "Apache-2.0",
  "author": "Chanatun Kohsuwan",
  "type": "module",
  "bin": {
    "tokensleft": "bin/tokensleft.js"
  },
  "files": [
    "bin/",
    "lib/",
    "providers/",
    ".env.example",
    "SECURITY.md",
    "README.*.md"
  ],
  "scripts": {
    "start": "node bin/tokensleft.js",
    "demo": "node bin/tokensleft.js --demo",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=70 --test-coverage-branches=80 --test-coverage-functions=80",
    "lint": "eslint .",
    "pricing:update": "node scripts/update-model-pricing.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "cli",
    "quota",
    "rate-limit",
    "usage",
    "claude",
    "claude-code",
    "codex",
    "gemini",
    "kimi",
    "kimi-code",
    "copilot",
    "grok",
    "ai"
  ],
  "dependencies": {
    "undici": "^7.29.1"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chanatundev/tokensleft.git"
  },
  "homepage": "https://github.com/chanatundev/tokensleft#readme",
  "bugs": {
    "url": "https://github.com/chanatundev/tokensleft/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
